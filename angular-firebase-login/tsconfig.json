{
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    // es2015 la version que usa para compilar y es muy vieja.
    "lib": [ "es2015", "dom" ],
    "module": "commonjs",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "sourceMap": true,
   // "suppressImplicitAnyIndexErrors": true,
    "target": "es5"
  }
}
